<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="LM Design — impressão 3D personalizada, prototipagem e peças funcionais.">
<title>LM Design | Impressão 3D</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

<style>
:root{
  --bg:#061116;
  --bg2:#091a20;
  --surface:#0d2027;
  --surface2:#102a32;
  --text:#f4fbfc;
  --muted:#9ab0b6;
  --teal:#10d9cf;
  --teal2:#00a9a3;
  --orange:#ff6b35;
  --line:rgba(255,255,255,.10);
  --glass:rgba(8,25,31,.74);
  --shadow:0 22px 70px rgba(0,0,0,.30);
  --radius:22px;
  --display:"Space Grotesk",sans-serif;
  --body:"DM Sans",sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  font-family:var(--body); color:var(--text); background:
  radial-gradient(circle at 12% 8%,rgba(0,217,207,.12),transparent 28%),
  radial-gradient(circle at 88% 32%,rgba(255,107,53,.10),transparent 25%),
  var(--bg);
  line-height:1.55; overflow-x:hidden;
}
body::before{
  content:"";position:fixed;inset:0;pointer-events:none;z-index:-1;opacity:.32;
  background-image:linear-gradient(rgba(255,255,255,.018) 1px,transparent 1px),
  linear-gradient(90deg,rgba(255,255,255,.018) 1px,transparent 1px);
  background-size:42px 42px;
}
a{color:inherit;text-decoration:none}
button,input,textarea{font:inherit}
button{cursor:pointer}
img{display:block;max-width:100%}
.container{width:min(1180px,calc(100% - 40px));margin:auto}
.progress{position:fixed;top:0;left:0;height:3px;width:0;background:linear-gradient(90deg,var(--teal),var(--orange));z-index:1000}
header{position:fixed;top:0;left:0;right:0;z-index:100;padding:14px 0}
.navbar{
  width:min(1160px,calc(100% - 32px));margin:auto;padding:12px 16px 12px 20px;
  display:flex;align-items:center;gap:28px;border:1px solid var(--line);
  border-radius:18px;background:rgba(5,18,23,.72);backdrop-filter:blur(18px);
  transition:.3s;
}
.navbar.scrolled{box-shadow:0 12px 40px rgba(0,0,0,.28);background:rgba(5,18,23,.92)}
.logo{display:flex;align-items:center;gap:10px;min-width:max-content}
.logo-mark{width:34px;height:34px;position:relative;display:block;transform:rotate(-8deg)}
.logo-mark span{position:absolute;width:20px;height:20px;border-radius:5px;transform:skewY(-25deg)}
.logo-mark span:first-child{background:var(--teal);left:0;top:0}
.logo-mark span:last-child{background:var(--orange);right:0;bottom:0}
.logo-text{font-family:var(--display);font-weight:700;letter-spacing:.02em;font-size:1.08rem}
.logo small{display:block;color:#87a0a7;font:500 .42rem var(--display);letter-spacing:.13em}
.nav-links{display:flex;align-items:center;gap:4px;margin-left:auto}
.nav-item{position:relative}
.nav-link{
  border:0;background:none;color:#b9c9cd;padding:10px 12px;border-radius:10px;
  transition:.25s;font-size:.9rem
}
.nav-link:hover,.nav-link.active{color:#fff;background:rgba(255,255,255,.06)}
.chev{font-size:.7rem;margin-left:4px;transition:.25s}
.nav-item:hover .chev{transform:rotate(180deg)}
.dropdown{
  position:absolute;top:calc(100% + 10px);left:0;min-width:230px;padding:8px;
  border:1px solid var(--line);border-radius:15px;background:rgba(7,24,30,.97);
  box-shadow:var(--shadow);opacity:0;visibility:hidden;transform:translateY(8px);
  transition:.22s;backdrop-filter:blur(18px)
}
.nav-item:hover .dropdown,.nav-item:focus-within .dropdown{opacity:1;visibility:visible;transform:translateY(0)}
.dropdown a{display:block;padding:11px 12px;border-radius:10px;color:#abc0c5;font-size:.87rem}
.dropdown a:hover{background:rgba(16,217,207,.08);color:var(--teal)}
.cta{
  display:inline-flex;align-items:center;justify-content:center;gap:9px;border:0;
  background:linear-gradient(135deg,var(--teal),#08aaa6);color:#032123;
  padding:12px 18px;border-radius:12px;font-weight:700;transition:.28s;
  box-shadow:0 8px 25px rgba(16,217,207,.15)
}
.cta:hover{transform:translateY(-3px);box-shadow:0 14px 35px rgba(16,217,207,.25)}
.menu-toggle{display:none;background:none;border:1px solid var(--line);color:#fff;border-radius:10px;padding:9px}
.hero{min-height:790px;padding:150px 0 80px;display:grid;grid-template-columns:1fr 1.05fr;align-items:center;gap:45px;position:relative}
.eyebrow{display:inline-flex;align-items:center;gap:8px;color:var(--teal);font:700 .68rem var(--display);letter-spacing:.17em;text-transform:uppercase;margin-bottom:18px}
.eyebrow:before{content:"";width:25px;height:2px;background:var(--teal)}
h1,h2,h3{font-family:var(--display)}
h1{font-size:clamp(2.7rem,5.4vw,5.2rem);line-height:.98;letter-spacing:-.055em;margin-bottom:24px}
h1 span{color:var(--teal)}
.lead{max-width:560px;color:var(--muted);font-size:1.05rem;margin-bottom:30px}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:38px}
.btn-secondary{
  display:inline-flex;align-items:center;gap:9px;padding:12px 17px;border:1px solid var(--line);
  border-radius:12px;background:rgba(255,255,255,.04);color:#fff;transition:.25s
}
.btn-secondary:hover{background:rgba(255,255,255,.08);transform:translateY(-3px)}
.stats{display:flex;gap:32px;flex-wrap:wrap}
.stat strong{font:700 1.5rem var(--display);display:block}
.stat span{font-size:.76rem;color:var(--muted)}
.hero-visual{height:510px;position:relative;display:grid;place-items:center}
.printer{
  width:min(510px,95%);height:380px;position:relative;border:1px solid rgba(16,217,207,.18);
  border-radius:22px;background:linear-gradient(145deg,#0b2027,#071217);
  box-shadow:0 30px 90px rgba(0,0,0,.45);transform:perspective(900px) rotateY(-8deg);
  animation:printerFloat 5s ease-in-out infinite
}
.printer:before,.printer:after{content:"";position:absolute;left:11%;right:11%;height:2px;background:#203a41}
.printer:before{top:18%}.printer:after{bottom:15%}
.rail{position:absolute;background:#27434a}
.rail.x{left:12%;right:12%;top:25%;height:5px}.rail.l{left:13%;top:16%;bottom:14%;width:5px}.rail.r{right:13%;top:16%;bottom:14%;width:5px}
.nozzle{position:absolute;left:48%;top:25%;width:28px;height:58px;background:#273b41;border-radius:4px;z-index:3}
.nozzle:after{content:"";position:absolute;left:8px;bottom:-10px;border-left:6px solid transparent;border-right:6px solid transparent;border-top:13px solid var(--orange)}
.print-bed{position:absolute;left:17%;right:17%;bottom:16%;height:25px;border-radius:5px;background:linear-gradient(90deg,#182d33,#31515a,#182d33);box-shadow:0 12px 20px rgba(0,0,0,.4)}
.vase{
  position:absolute;bottom:25%;left:50%;transform:translateX(-50%);width:105px;height:130px;
  border-radius:46% 46% 18% 18% / 28% 28% 14% 14%;
  background:repeating-linear-gradient(90deg,#0fcfc5 0 4px,#0a8f8c 5px 7px);
  filter:drop-shadow(0 0 22px rgba(16,217,207,.3));animation:vasePulse 4s ease-in-out infinite
}
.vase:before{content:"";position:absolute;top:-10px;left:25px;width:55px;height:18px;border-radius:50%;background:#0b6f6d}
.visual-badge{position:absolute;padding:13px 16px;border:1px solid rgba(16,217,207,.25);border-radius:14px;background:rgba(8,28,34,.9);box-shadow:var(--shadow);font-size:.76rem;backdrop-filter:blur(12px);animation:badgeFloat 4s ease-in-out infinite}
.visual-badge b{display:block;color:#fff;font-size:.86rem;margin-top:2px}
.visual-badge.one{right:-5px;top:17%}.visual-badge.two{left:-10px;bottom:18%;animation-delay:1s}
section{padding:100px 0}
.section-head{display:flex;align-items:end;justify-content:space-between;gap:25px;margin-bottom:38px}
.section-head p{max-width:530px;color:var(--muted)}
h2{font-size:clamp(2rem,4vw,3.3rem);line-height:1.02;letter-spacing:-.04em}
h2 span{color:var(--teal)}
.dark-section{background:linear-gradient(180deg,rgba(10,31,38,.65),rgba(5,18,23,.92));border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.feature-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:20px;overflow:hidden}
.feature{padding:30px;background:rgba(7,22,27,.88);transition:.3s}
.feature:hover{background:#0d2931;transform:translateY(-4px)}
.icon{width:45px;height:45px;display:grid;place-items:center;border:1px solid rgba(16,217,207,.35);border-radius:13px;color:var(--teal);font-size:1.2rem;margin-bottom:20px}
.feature h3{font-size:1.02rem;margin-bottom:8px}.feature p{color:var(--muted);font-size:.86rem}
.filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:24px}
.filter{border:1px solid var(--line);background:rgba(255,255,255,.03);color:#a9bdc2;border-radius:999px;padding:8px 13px;font-size:.8rem;transition:.2s}
.filter:hover,.filter.active{background:rgba(16,217,207,.12);border-color:rgba(16,217,207,.35);color:var(--teal)}
.gallery{display:grid;grid-template-columns:repeat(5,1fr);gap:16px}
.card{
  background:var(--surface);border:1px solid var(--line);border-radius:18px;overflow:hidden;
  transition:transform .35s,box-shadow .35s,border-color .35s;cursor:pointer
}
.card:hover{transform:translateY(-9px) rotateX(2deg);box-shadow:0 25px 55px rgba(0,0,0,.32);border-color:rgba(16,217,207,.35)}
.card-image{height:190px;overflow:hidden;background:#eef1f1}
.card-image img{width:100%;height:100%;object-fit:cover;transition:.45s}
.card:hover img{transform:scale(1.08)}
.card-body{padding:16px}.tag{font-size:.67rem;color:var(--teal);font-weight:700;text-transform:uppercase;letter-spacing:.08em}
.card h3{font-size:1rem;margin:5px 0}.card p{font-size:.78rem;color:var(--muted)}
.card-arrow{margin-top:13px;color:#fff;font-size:.8rem;display:flex;justify-content:space-between}
.materials{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.material{
  padding:24px;border-radius:18px;border:1px solid var(--line);background:linear-gradient(145deg,#0d2229,#09171c);
  transition:.3s;position:relative;overflow:hidden
}
.material:hover{transform:translateY(-7px);border-color:rgba(16,217,207,.3)}
.material:after{content:"";position:absolute;width:130px;height:130px;border-radius:50%;right:-50px;top:-50px;background:rgba(16,217,207,.08)}
.swatch{width:42px;height:42px;border-radius:12px;margin-bottom:20px}
.material h3{margin-bottom:7px}.material p{font-size:.83rem;color:var(--muted);margin-bottom:17px}
.spec{padding-top:14px;border-top:1px dashed var(--line);display:flex;justify-content:space-between;font-size:.72rem;color:#7f989e}
.spec b{color:#fff}
.process-wrap{background:#07161b;border:1px solid var(--line);border-radius:25px;padding:42px}
.process{display:grid;grid-template-columns:repeat(4,1fr);gap:0}
.step{padding:0 25px;position:relative}.step:first-child{padding-left:0}.step:last-child{padding-right:0}
.step:not(:last-child):after{content:"→";position:absolute;right:-5px;top:10px;color:#38545b;font-size:1.4rem}
.step-number{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:var(--teal);color:#052225;font-weight:800;margin-bottom:18px}
.step h3{font-size:1rem;margin-bottom:7px}.step p{font-size:.82rem;color:var(--muted)}
.contact{
  padding:45px;border-radius:25px;background:linear-gradient(120deg,#0c2b31,#11232a 55%,#542717);
  border:1px solid var(--line);display:grid;grid-template-columns:1fr 1fr;gap:40px;overflow:hidden;position:relative
}
.contact:after{content:"";position:absolute;width:340px;height:340px;border-radius:50%;right:-120px;bottom:-200px;background:rgba(255,107,53,.18)}
.contact p{color:#a7b9bd;max-width:500px;margin:12px 0 24px}
.contact-details{display:grid;gap:8px;color:#dce7e9;font-size:.86rem}.contact-details b{color:var(--teal)}
form{display:grid;gap:12px;position:relative;z-index:1}
input,textarea{width:100%;border:1px solid rgba(255,255,255,.12);background:rgba(0,0,0,.18);color:#fff;border-radius:12px;padding:13px 14px;outline:none}
input:focus,textarea:focus{border-color:var(--teal);box-shadow:0 0 0 3px rgba(16,217,207,.08)}
textarea{min-height:120px;resize:vertical}
footer{padding:45px 0;color:#789197;font-size:.78rem}
.footer{display:flex;justify-content:space-between;gap:20px;align-items:center;flex-wrap:wrap;border-top:1px solid var(--line);padding-top:25px}
.footer-links{display:flex;gap:18px}.footer-links a:hover{color:#fff}
.reveal{opacity:0;transform:translateY(28px);transition:opacity .7s ease,transform .7s ease}
.reveal.in{opacity:1;transform:none}
.delay-1{transition-delay:.08s}.delay-2{transition-delay:.16s}.delay-3{transition-delay:.24s}.delay-4{transition-delay:.32s}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.72);display:grid;place-items:center;padding:20px;z-index:500;opacity:0;visibility:hidden;transition:.25s;backdrop-filter:blur(8px)}
.modal.open{opacity:1;visibility:visible}
.modal-box{width:min(600px,100%);background:#0b2027;border:1px solid var(--line);border-radius:22px;padding:28px;box-shadow:var(--shadow);transform:scale(.94);transition:.25s}
.modal.open .modal-box{transform:scale(1)}
.modal-box img{width:100%;height:250px;object-fit:cover;border-radius:15px;margin-bottom:20px}
.modal-top{display:flex;justify-content:space-between;gap:15px}.close{border:1px solid var(--line);background:transparent;color:#fff;width:38px;height:38px;border-radius:10px}
.toast{position:fixed;right:20px;bottom:20px;background:#0e292f;border:1px solid rgba(16,217,207,.3);padding:14px 17px;border-radius:12px;box-shadow:var(--shadow);transform:translateY(120px);transition:.3s;z-index:600;font-size:.84rem}
.toast.show{transform:translateY(0)}
@keyframes printerFloat{0%,100%{transform:perspective(900px) rotateY(-8deg) translateY(0)}50%{transform:perspective(900px) rotateY(-8deg) translateY(-10px)}}
@keyframes vasePulse{0%,100%{filter:drop-shadow(0 0 18px rgba(16,217,207,.25))}50%{filter:drop-shadow(0 0 35px rgba(16,217,207,.48))}}
@keyframes badgeFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
@media (max-width:950px){
  .nav-links{display:none}.menu-toggle{display:block;margin-left:auto}.navbar.open .nav-links{
    display:flex;position:absolute;top:72px;left:0;right:0;padding:10px;flex-direction:column;
    align-items:stretch;background:#07161b;border:1px solid var(--line);border-radius:16px
  }
  .navbar.open .nav-item .dropdown{position:static;display:none;opacity:1;visibility:visible;transform:none;box-shadow:none}
  .navbar.open .nav-item.open .dropdown{display:block}
  .hero{grid-template-columns:1fr;padding-top:130px}.hero-visual{order:-1;height:390px}.printer{width:430px;height:320px}
  .feature-grid{grid-template-columns:repeat(2,1fr)}.gallery{grid-template-columns:repeat(3,1fr)}.materials{grid-template-columns:repeat(2,1fr)}
  .process{grid-template-columns:repeat(2,1fr);gap:35px}.step:nth-child(2):after{display:none}.contact{grid-template-columns:1fr}
}
@media (max-width:620px){
  .container{width:min(100% - 28px,1180px)}header{padding:8px 0}.navbar{width:calc(100% - 18px)}
  .navbar>.cta{display:none}.hero{padding-top:115px}.hero-visual{height:300px}.printer{width:100%;height:250px}.vase{width:72px;height:90px}
  .visual-badge{font-size:.64rem;padding:9px}.visual-badge.one{right:-2px}.visual-badge.two{left:-2px}
  h1{font-size:2.65rem}.stats{gap:20px}.feature-grid,.gallery,.materials,.process{grid-template-columns:1fr}
  .step{padding:0}.step:not(:last-child):after{display:none}.process-wrap,.contact{padding:25px}
  section{padding:72px 0}.section-head{align-items:start;flex-direction:column}.card-image{height:210px}
}
@media (prefers-reduced-motion:reduce){
  *,*:before,*:after{animation-duration:.01ms!important;transition-duration:.01ms!important;scroll-behavior:auto!important}
}
</style>
</head>

<body>
<div class="progress" id="progress"></div>

<header>
  <div class="navbar" id="navbar">
    <a href="#inicio" class="logo" aria-label="LM Design">
      <span class="logo-mark"><span></span><span></span></span>
      <span><span class="logo-text">LM DESIGN</span><small>IMPRESSÃO 3D DE ALTA TECNOLOGIA</small></span>
    </a>

    <nav class="nav-links" id="navLinks">
      <a class="nav-link active" href="#inicio">Início</a>

      <div class="nav-item">
        <button class="nav-link dropdown-trigger">Serviços <span class="chev">⌄</span></button>
        <div class="dropdown">
          <a href="#processo">Prototipagem rápida</a>
          <a href="#galeria">Peças funcionais</a>
          <a href="#galeria">Peças personalizadas</a>
          <a href="#contato">Lotes e produção</a>
        </div>
      </div>

      <div class="nav-item">
        <button class="nav-link dropdown-trigger">Materiais <span class="chev">⌄</span></button>
        <div class="dropdown">
          <a href="#materiais">PLA — protótipos e decoração</a>
          <a href="#materiais">PETG — resistência</a>
          <a href="#materiais">Resina — alto detalhe</a>
          <a href="#materiais">TPU — flexível</a>
        </div>
      </div>

      <div class="nav-item">
        <button class="nav-link dropdown-trigger">Exemplos <span class="chev">⌄</span></button>
        <div class="dropdown">
          <a href="#galeria" data-filter="funcional">Peças funcionais</a>
          <a href="#galeria" data-filter="organizacao">Organização</a>
          <a href="#galeria" data-filter="prototipo">Protótipos</a>
          <a href="#galeria" data-filter="decoracao">Decoração</a>
        </div>
      </div>

      <a class="nav-link" href="#sobre">Sobre nós</a>
      <a class="nav-link" href="#contato">Contato</a>
    </nav>

    <a class="cta" href="#contato">Solicite seu orçamento <span>→</span></a>
    <button class="menu-toggle" id="menuToggle" aria-label="Abrir menu">☰</button>
  </div>
</header>

<main id="inicio">
  <section class="hero container">
    <div class="reveal">
      <div class="eyebrow">Ideias que ganham forma</div>
      <h1>Soluções em <span>Impressão 3D</span> para o seu projeto.</h1>
      <p class="lead">Transformamos arquivos, ideias e necessidades em peças reais com precisão, personalização e acabamento profissional — do protótipo à produção.</p>
      <div class="hero-actions">
        <a class="cta" href="#contato">Solicite seu orçamento →</a>
        <a class="btn-secondary" href="#processo">▶ Conheça nosso processo</a>
      </div>
      <div class="stats">
        <div class="stat"><strong>0,1 mm</strong><span>precisão de camada</span></div>
        <div class="stat"><strong>4+</strong><span>materiais disponíveis</span></div>
        <div class="stat"><strong>100%</strong><span>personalização</span></div>
      </div>
    </div>

    <div class="hero-visual reveal delay-2" id="heroVisual">
      <div class="printer">
        <div class="rail x"></div><div class="rail l"></div><div class="rail r"></div>
        <div class="nozzle"></div><div class="vase"></div><div class="print-bed"></div>
      </div>
      <div class="visual-badge one">◎ <b>Alta precisão</b><small>Detalhes que fazem a diferença</small></div>
      <div class="visual-badge two">⚡ <b>Produção rápida</b><small>Do arquivo à peça</small></div>
    </div>
  </section>

  <section class="dark-section" id="sobre">
    <div class="container">
      <div class="feature-grid">
        <article class="feature reveal"><div class="icon">◇</div><h3>Alta precisão</h3><p>Impressões com excelente nível de detalhe e acabamento profissional.</p></article>
        <article class="feature reveal delay-1"><div class="icon">▱</div><h3>Diversos materiais</h3><p>PLA, PETG, resina, TPU e outras opções conforme a necessidade.</p></article>
        <article class="feature reveal delay-2"><div class="icon">⚙</div><h3>Personalização total</h3><p>Do tamanho à cor e acabamento, cada peça pode ser adaptada ao projeto.</p></article>
        <article class="feature reveal delay-3"><div class="icon">◷</div><h3>Atendimento especializado</h3><p>Suporte desde a análise do arquivo até a entrega da peça.</p></article>
      </div>
    </div>
  </section>

  <section id="galeria">
    <div class="container">
      <div class="section-head reveal">
        <div><div class="eyebrow">Exemplos de peças</div><h2>Veja o que <span>podemos criar</span></h2></div>
        <p>Use os filtros para encontrar rapidamente o tipo de peça que mais combina com sua necessidade.</p>
      </div>

      <div class="filters reveal">
        <button class="filter active" data-gallery-filter="todos">Todos</button>
        <button class="filter" data-gallery-filter="funcional">Funcionais</button>
        <button class="filter" data-gallery-filter="organizacao">Organização</button>
        <button class="filter" data-gallery-filter="prototipo">Protótipos</button>
        <button class="filter" data-gallery-filter="decoracao">Decoração</button>
      </div>

      <div class="gallery">
        <article class="card reveal" data-category="funcional" data-title="Engrenagens funcionais" data-desc="Conjunto de engrenagens para mecanismos, protótipos e projetos de automação." data-image="engrenagens">
          <div class="card-image"><img src="data:image/jpeg;base64," alt="Exemplo de engrenagens impressas em 3D"></div>
          <div class="card-body"><span class="tag">Funcional</span><h3>Engrenagens</h3><p>Peças resistentes para mecanismos.</p><div class="card-arrow">Ver detalhes <b>→</b></div></div>
        </article>

        <article class="card reveal delay-1" data-category="funcional" data-title="Suporte técnico" data-desc="Suportes personalizados para fixação, organização e adaptação de equipamentos." data-image="suporte">
          <div class="card-image"><img src="data:image/jpeg;base64," alt="Exemplo de suporte técnico impresso em 3D"></div>
          <div class="card-body"><span class="tag">Funcional</span><h3>Suportes</h3><p>Fixação e organização sob medida.</p><div class="card-arrow">Ver detalhes <b>→</b></div></div>
        </article>

        <article class="card reveal delay-2" data-category="organizacao" data-title="Organizador modular" data-desc="Peça para organização de ferramentas, componentes, acessórios e pequenos objetos." data-image="organizador">
          <div class="card-image"><img src="data:image/jpeg;base64," alt="Exemplo de organizador impresso em 3D"></div>
          <div class="card-body"><span class="tag">Organização</span><h3>Organizadores</h3><p>Mais praticidade no dia a dia.</p><div class="card-arrow">Ver detalhes <b>→</b></div></div>
        </article>

        <article class="card reveal delay-3" data-category="prototipo" data-title="Protótipo técnico" data-desc="Estruturas e modelos para validar encaixes, dimensões e conceitos antes da produção." data-image="prototipo">
          <div class="card-image"><img src="data:image/jpeg;base64," alt="Exemplo de protótipo impresso em 3D"></div>
          <div class="card-body"><span class="tag">Protótipo</span><h3>Protótipos</h3><p>Valide ideias antes da produção.</p><div class="card-arrow">Ver detalhes <b>→</b></div></div>
        </article>

        <article class="card reveal delay-4" data-category="decoracao" data-title="Peças decorativas" data-desc="Modelos decorativos e presentes personalizados com liberdade de formas, escalas e cores." data-image="decoracao">
          <div class="card-image"><img src="data:image/jpeg;base64," alt="Exemplo de peça decorativa impressa em 3D"></div>
          <div class="card-body"><span class="tag">Decoração</span><h3>Decoração</h3><p>Personagens e peças criativas.</p><div class="card-arrow">Ver detalhes <b>→</b></div></div>
        </article>
      </div>
    </div>
  </section>

  <section class="dark-section" id="materiais">
    <div class="container">
      <div class="section-head reveal">
        <div><div class="eyebrow">Materiais</div><h2>Um material para cada <span>ideia</span></h2></div>
        <p>A escolha depende do uso, resistência, flexibilidade, detalhe e acabamento desejados.</p>
      </div>
      <div class="materials">
        <article class="material reveal"><div class="swatch" style="background:linear-gradient(135deg,#10d9cf,#087e7a)"></div><h3>PLA</h3><p>Ótimo para protótipos visuais, decoração e peças de uso leve.</p><div class="spec"><span>Acabamento</span><b>Fosco</b></div></article>
        <article class="material reveal delay-1"><div class="swatch" style="background:linear-gradient(135deg,#5575c8,#273d75)"></div><h3>PETG</h3><p>Boa resistência a impacto e temperatura para peças funcionais.</p><div class="spec"><span>Resistência</span><b>Alta</b></div></article>
        <article class="material reveal delay-2"><div class="swatch" style="background:linear-gradient(135deg,#a778ed,#6036a0)"></div><h3>Resina SLA</h3><p>Excelente nível de detalhe para miniaturas e peças delicadas.</p><div class="spec"><span>Detalhe</span><b>Altíssimo</b></div></article>
        <article class="material reveal delay-3"><div class="swatch" style="background:linear-gradient(135deg,#ff7a45,#b73d17)"></div><h3>TPU flexível</h3><p>Material maleável para capas, proteções, juntas e peças flexíveis.</p><div class="spec"><span>Característica</span><b>Flexível</b></div></article>
      </div>
    </div>
  </section>

  <section id="processo">
    <div class="container">
      <div class="section-head reveal">
        <div><div class="eyebrow">Como funciona</div><h2>Do pedido à entrega, <span>sem complicação</span></h2></div>
      </div>
      <div class="process-wrap reveal">
        <div class="process">
          <article class="step"><div class="step-number">1</div><h3>Envie seu projeto</h3><p>Mande STL, OBJ ou explique sua ideia para nossa equipe.</p></article>
          <article class="step"><div class="step-number">2</div><h3>Definimos os detalhes</h3><p>Escolhemos material, cor, escala e acabamento.</p></article>
          <article class="step"><div class="step-number">3</div><h3>Produzimos</h3><p>Fatiamos e imprimimos com parâmetros adequados à peça.</p></article>
          <article class="step"><div class="step-number">4</div><h3>Você recebe</h3><p>Finalizamos, conferimos e combinamos a entrega.</p></article>
        </div>
      </div>
    </div>
  </section>

  <section id="contato">
    <div class="container">
      <div class="contact reveal">
        <div>
          <div class="eyebrow">Vamos conversar</div>
          <h2>Tem um projeto em mente?</h2>
          <p>Envie os detalhes e receba uma orientação inicial para transformar sua ideia em uma peça real.</p>
          <div class="contact-details">
            <div>e-mail: <b>lmdesign@gmail.com</b></div>
            <div>whatsapp: <b>(31) 99238-0853</b></div>
          </div>
        </div>
        <form id="quoteForm">
          <input type="text" placeholder="Seu nome" required>
          <input type="email" placeholder="Seu e-mail" required>
          <textarea placeholder="Descreva seu projeto..." required></textarea>
          <button class="cta" type="submit">Enviar pedido →</button>
        </form>
      </div>
    </div>
  </section>
</main>

<footer>
  <div class="container footer">
    <a href="#inicio" class="logo">
      <span class="logo-mark"><span></span><span></span></span>
      <span><span class="logo-text">LM DESIGN</span><small>IMPRESSÃO 3D</small></span>
    </a>
    <div class="footer-links"><a href="#galeria">Exemplos</a><a href="#materiais">Materiais</a><a href="#processo">Processo</a><a href="#contato">Contato</a></div>
    <span>© 2026 LM Design. Todos os direitos reservados.</span>
  </div>
</footer>

<div class="modal" id="modal">
  <div class="modal-box">
    <div class="modal-top"><div><div class="eyebrow">Exemplo de peça</div><h2 id="modalTitle">Peça</h2></div><button class="close" id="closeModal">×</button></div>
    <img id="modalImage" src="" alt="">
    <p id="modalDesc" style="color:var(--muted)"></p>
    <div style="margin-top:20px"><a class="cta" href="#contato" id="modalQuote">Quero uma peça assim →</a></div>
  </div>
</div>
<div class="toast" id="toast">Pedido preparado! Agora é só conectar o formulário a um serviço de envio.</div>

<script>
const navbar = document.getElementById('navbar');
const progress = document.getElementById('progress');
window.addEventListener('scroll',()=>{
  navbar.classList.toggle('scrolled',scrollY>15);
  const h=document.documentElement.scrollHeight-innerHeight;
  progress.style.width=(h>0?(scrollY/h)*100:0)+'%';
},{passive:true});

const menuToggle=document.getElementById('menuToggle');
menuToggle.addEventListener('click',()=>navbar.classList.toggle('open'));

document.querySelectorAll('.dropdown-trigger').forEach(btn=>{
  btn.addEventListener('click',e=>{
    if(innerWidth<=950){
      e.preventDefault();
      btn.parentElement.classList.toggle('open');
    }
  });
});

document.querySelectorAll('.nav-links a:not(.dropdown a)').forEach(a=>{
  a.addEventListener('click',()=>navbar.classList.remove('open'));
});

const observer=new IntersectionObserver(entries=>{
  entries.forEach(entry=>{
    if(entry.isIntersecting){entry.target.classList.add('in');observer.unobserve(entry.target)}
  });
},{threshold:.12});
document.querySelectorAll('.reveal').forEach(el=>observer.observe(el));

const filters=document.querySelectorAll('[data-gallery-filter]');
const cards=document.querySelectorAll('.card');
function applyFilter(filter){
  filters.forEach(b=>b.classList.toggle('active',b.dataset.galleryFilter===filter));
  cards.forEach(card=>{
    card.style.display=(filter==='todos'||card.dataset.category===filter)?'':'none';
  });
}
filters.forEach(btn=>btn.addEventListener('click',()=>applyFilter(btn.dataset.galleryFilter)));

document.querySelectorAll('[data-filter]').forEach(link=>{
  link.addEventListener('click',()=>{
    applyFilter(link.dataset.filter);
    navbar.classList.remove('open');
  });
});

const modal=document.getElementById('modal');
const modalTitle=document.getElementById('modalTitle');
const modalDesc=document.getElementById('modalDesc');
const modalImage=document.getElementById('modalImage');
const imageMap={
  engrenagens:document.querySelector('[data-image="engrenagens"] img').src,
  suporte:document.querySelector('[data-image="suporte"] img').src,
  organizador:document.querySelector('[data-image="organizador"] img').src,
  prototipo:document.querySelector('[data-image="prototipo"] img').src,
  decoracao:document.querySelector('[data-image="decoracao"] img').src
};
cards.forEach(card=>card.addEventListener('click',()=>{
  modalTitle.textContent=card.dataset.title;
  modalDesc.textContent=card.dataset.desc;
  modalImage.src=imageMap[card.dataset.image];
  modalImage.alt=card.dataset.title;
  modal.classList.add('open');
}));
function closeModal(){modal.classList.remove('open')}
document.getElementById('closeModal').addEventListener('click',closeModal);
modal.addEventListener('click',e=>{if(e.target===modal)closeModal()});
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal()});

document.getElementById('quoteForm').addEventListener('submit',e=>{
  e.preventDefault();
  const toast=document.getElementById('toast');
  toast.classList.add('show');
  e.target.querySelector('button').textContent='Pedido enviado ✓';
  setTimeout(()=>toast.classList.remove('show'),4000);
});
document.getElementById('modalQuote').addEventListener('click',closeModal);

if(window.matchMedia('(prefers-reduced-motion: reduce)').matches){
  document.querySelectorAll('.reveal').forEach(el=>el.classList.add('in'));
}
</script>
</body>
</html>
